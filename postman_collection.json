{
  "info": {
    "name": "Rideshare API - collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Register",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"username\":\"alice\",\"password\":\"pass123\",\"role\":\"ROLE_USER\"}"
        },
        "url": {
          "raw": "http://localhost:8081/api/auth/register",
          "host": [
            "http://localhost:8081"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        }
      }
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"username\":\"alice\",\"password\":\"pass123\"}"
        },
        "url": {
          "raw": "http://localhost:8081/api/auth/login",
          "host": [
            "http://localhost:8081"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        }
      }
    },
    {
      "name": "Create Ride (user)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{ \"pickupLocation\":\"Point A\", \"dropLocation\":\"Point B\" }"
        },
        "url": {
          "raw": "http://localhost:8081/api/v1/rides",
          "host": [
            "http://localhost:8081"
          ],
          "path": [
            "api",
            "v1",
            "rides"
          ]
        }
      }
    },
    {
      "name": "List Requests (driver)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token_driver}}"
          }
        ],
        "url": {
          "raw": "http://localhost:8081/api/v1/driver/rides/requests",
          "host": [
            "http://localhost:8081"
          ],
          "path": [
            "api",
            "v1",
            "driver",
            "rides",
            "requests"
          ]
        }
      }
    }
  ]
}